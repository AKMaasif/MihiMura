# FastAPI backend
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Firebase Web app config — required for real email/password + Google login
# Firebase web config values are client configuration. Never put Firebase Admin service-account JSON here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional browser push notifications
VITE_FIREBASE_VAPID_KEY=

# true = app remains usable with demo authentication when Firebase is not configured
VITE_DEMO_AUTH=true
