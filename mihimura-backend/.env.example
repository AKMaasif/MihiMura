# Core
DEMO_MODE=true
DATABASE_PATH=mihimura.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini — required for real AI chat + crop-image analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin — required to verify Firebase users on the backend in production
# Download the service account JSON and keep it OUT of Git.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=

# Copernicus Data Space / Sentinel Hub — optional live satellite catalogue
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Open-Meteo and NASA POWER currently require no API key.
