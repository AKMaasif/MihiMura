# MihiMura backend - local development
DEMO_MODE=true
# Local demo only. Set false on any server that is reachable beyond your own machine.
# While true, the demo farmer can open admin, evaluation and knowledge-editor tools.
DEMO_PRIVILEGED=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (backend-only service role must NEVER be placed in the React app)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_REPORTS_BUCKET=mihimura-reports
SUPABASE_ATTACHMENTS_BUCKET=mihimura-attachments
SUPABASE_KNOWLEDGE_BUCKET=mihimura-knowledge

# AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Model tiers (comma-separated, tried in order; unavailable models are skipped)
GEMINI_REASONING_MODELS=gemini-4-argon,gemini-3.8-flash,gemini-2.5-flash
GEMINI_FAST_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
RAG_TOP_K=8
RAG_CHUNK_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=220
RAG_EMBED_BATCH_SIZE=16
RAG_EMBED_TIMEOUT_MS=45000
RAG_EMBED_MAX_RETRIES=3
RAG_EMBED_RETRY_BASE_SECONDS=1.5
RAG_MAX_EXCERPT_CHARS=1200
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Algenib

# Other voices you can try: Gacrux

# Satellite (optional)
SENTINEL_CLIENT_ID=YOUR_SENTINEL_CLIENT_ID
SENTINEL_CLIENT_SECRET=YOUR_SENTINEL_CLIENT_SECRET
SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_BASE_URL=https://sh.dataspace.copernicus.eu


OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
MAX_UPLOAD_MB=8

# Optional Unicode PDF font overrides. Usually not needed on Windows; Docker installs Noto fonts.
# MIHIMURA_SINHALA_FONT_PATH=C:\Windows\Fonts\Nirmala.ttf
# MIHIMURA_SINHALA_BOLD_FONT_PATH=C:\Windows\Fonts\NirmalaB.ttf
# MIHIMURA_TAMIL_FONT_PATH=C:\Windows\Fonts\Nirmala.ttf
# MIHIMURA_TAMIL_BOLD_FONT_PATH=C:\Windows\Fonts\NirmalaB.ttf
